# Copy to /etc/ultranet-records/records.env — the path ultranet-records.service reads — and restrict it to
# root:ultranet-records (0640).
# This file holds limits and endpoints only. Never put the chain owner's key or passphrase, or the peer
# secret, here: they arrive as systemd credentials. The Games Reward Service has its own file and its own
# credentials; nothing is shared between the two except the peer secret.
#
# Every limit below may be TIGHTENED. The service refuses to start if one is loosened past its ceiling
# (src/games/records_config.rs); a value over a ceiling is an error, never a quiet clamp.
# `ultranet-records check-config` prints what is in force.

# Loopback only: publish it through the reverse proxy (deploy/Caddyfile.example). The signed
# /internal/v1/anchor route is never routed by the proxy.
RECORDS_BIND=127.0.0.1:8096
RECORDS_DB_PATH=/var/lib/ultranet-records/records.db
RECORDS_NODE_API_BASE_URL=http://127.0.0.1:8081

# The AppChain the registry's one daily root is anchored to. Leave unset until it is registered (owner
# action, 0.01 $ULTRA): days are still closed and every root is still fixed, but nothing is anchored.
# It must not be 0 (the L1) nor a chain the Games Reward Service may anchor (RECORDS_PEER_ANCHOR_CHAINS).
# RECORDS_REGISTRY_CHAIN_ID=3

# Anchoring runs appchain-cli with the owner key credential. Leave unset to anchor nothing.
# RECORDS_ANCHOR_CLI=/opt/ultranet-records/appchain-cli
RECORDS_ANCHOR_RETRY_SECONDS=600
RECORDS_ANCHOR_TIMEOUT_SECONDS=60

# The chains the Games Reward Service may ask this service to anchor for it: UltraGrid (#1) and Ultra Chess
# (#2). Never the registry's chain, never 0. A compromised Games service holds a valid peer secret, so this
# list is what limits it.
RECORDS_PEER_ANCHOR_CHAINS=1,2
# The most distinct roots the Games service may have anchored per UTC day (ceiling 100). Normal use is one
# per game per day; each real anchor costs the owner wallet 0.001 $ULTRA, so this bounds what a compromised
# Games service could spend. A repeated ask for the same root does not count.
RECORDS_PEER_ANCHORS_PER_DAY=8
# The allowance is kept in the database: restarting or crashing the service does not reset it.
# The most times one root may be submitted per UTC day (ceiling 10), so a failing root cannot be retried into
# a pile of fees. Each real submission costs 0.001 $ULTRA.
RECORDS_PEER_SUBMISSIONS_PER_ROOT=3
# Set to the credential name (the file records-peer-games.key) to open /internal/v1/anchor. Unset: the
# route does not exist.
# RECORDS_PEER_CREDENTIAL=records-peer-games.key
# REQUIRED whenever anything is anchored (RECORDS_ANCHOR_CLI set), and when the peer route is on: the address of the owner key (what `appchain-cli address` prints for
# records-anchor-owner.key.enc). An anchor whose outcome is unknown can only be reconciled by reading the
# owner's transaction history; `check-config` verifies this address against the key.
# RECORDS_OWNER_ADDRESS=<64 lowercase hex>

# Self-registration needs the owner's address to exist on the chain (a faucet claim or a payment received).
RECORDS_REQUIRE_CHAIN_PRESENCE=true
# Limits per UTC day. Ceilings: 1000000 / 100000 / 10000 / 20 / 5000; 0 is refused.
RECORDS_RESULTS_PER_GAME_PER_DAY=50000
RECORDS_RESULTS_PER_PLAYER_PER_DAY=1000
# A sandbox game is free, private and never anchored, so its day is small.
RECORDS_SANDBOX_RESULTS_PER_DAY=500
RECORDS_GAMES_PER_OWNER=3
RECORDS_SELF_REGISTRATIONS_PER_DAY=100
