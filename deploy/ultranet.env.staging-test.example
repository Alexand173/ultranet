# UltraNet disposable node environment template.
# REVIEW ONLY: disposable Phase 2 node test; never use for production.
# This file contains policy and endpoint values only. It must not contain a
# token value, private key, signer material, wallet secret, or production path.
# The accompanying unit injects ULTRANET_ADMIN_TOKEN_FILE from an encrypted
# systemd credential. Do not add ULTRANET_ADMIN_TOKEN or token contents here.
# Use the exact locked binary that implements every variable below.

# Keep the node API on loopback; the faucet may use this same local port only.
ULTRANET_API_BIND=127.0.0.1:8081
ULTRANET_CORS_ORIGINS=http://127.0.0.1:8081

# Disposable state only. Never point this at /var/lib/ultranet or a backup.
ULTRANET_DB_PATH=/var/lib/ultranet-staging
ULTRANET_PAUSE_ON_ERROR=false

# ULTRANET_ADMIN_TOKEN_FILE is injected by deploy/ultranet-staging.service.
# ULTRANET_ADMIN_TOKEN must remain unset.

# No production or remote peers. Empty values are intentional and must be
# rejected if disposable-mode runtime support tries to add a default peer.
ULTRANET_PERSISTENT_PEERS=
ULTRANET_BOOTNODES=

# The runtime must enforce this as a separate disposable network profile. A
# value that only changes a log line or topic without validating peer/profile
# boundaries is not sufficient for Phase 2.
ULTRANET_DISPOSABLE_MODE=true
ULTRANET_NETWORK_ID=ultranet-disposable-test-01
ULTRANET_P2P_BIND=/ip4/127.0.0.1/tcp/19000

# No web approvals or test-only anchoring in the node preflight.
ULTRANET_WEB_APPROVAL_ENABLED=false
ULTRANET_ENABLE_TEST_ANCHORING=false
