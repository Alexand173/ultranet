[Unit]
Description=UltraNet isolated Sovereign approval signer (owner %i)
Requires=ultranet-approval-signer@%i.socket
After=ultranet-approval-signer@%i.socket

[Service]
Type=simple
User=ultranet-approver-%i
Group=ultranet-approval-owner-%i
UMask=0077
WorkingDirectory=/opt/ultranet
EnvironmentFile=-/etc/ultranet/approval-signer-%i.env
# Deliberately omit --unattended. The checked-in file adapter requires local
# APPROVE presence; production should replace it with an audited HSM or
# separately administered signer host rather than bypassing owner presence.
# The socket is owned and permissioned by the matching .socket unit.
ExecStart=/opt/ultranet/target/release/ultranet-approval-signer \
  --socket /run/ultranet-approval-signer/owner-%i/approval.sock \
  --keys /var/lib/ultranet-approval-signer/owner-%i/key.json \
  --owner-index %i \
  --key-index 0 \
  --signer-id owner-%i
StandardInput=null

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/ultranet-approval-signer
RestrictAddressFamilies=AF_UNIX

Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ultranet-approval-signer-%i

[Install]
WantedBy=multi-user.target
