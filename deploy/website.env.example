# Runtime values for the Next.js dashboard service.
# NEXT_PUBLIC_* values are embedded at build time; rebuild the website after changing them.
# Install build dependencies with `npm ci --include=dev`; keep NODE_ENV=production at runtime.
NODE_ENV=production
NEXT_PUBLIC_API_BASE_URL=https://api.ultranetwork.cc
NEXT_PUBLIC_EXPLORER_URL=https://api.ultranetwork.cc/dashboard
