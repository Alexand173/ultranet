# Copy to /etc/ultranet-games/games.env — the path ultranet-games.service reads — and restrict it to
# root:ultranet-games (0640).
# This file holds policy and endpoint values only. Never put the payout key, the abuse key, the chain
# owner's key or passphrase, or ULTRANET_ADMIN_TOKEN here: those arrive as systemd credentials.
#
# Every rule below may be TIGHTENED. The service refuses to start if one is loosened past its ceiling
# (see src/games/config.rs and docs/GAMES_RULES_AND_PAYOUTS.md §3); a value over a ceiling is an error,
# never a quiet clamp. `ultranet-games check-config` prints the rules in force.

# Loopback only: publish it through the reverse proxy (deploy/Caddyfile.example).
GAMES_BIND=127.0.0.1:8095
GAMES_DB_PATH=/var/lib/ultranet-games/games.db

# The node's private API, the same one the faucet uses.
GAMES_NODE_API_BASE_URL=http://127.0.0.1:8081

# REQUIRED. The payout wallet: the address derived from games-payout-signer.json. A mismatch stops the
# service at start. Generate the key with `ultranet-faucet keygen --output <path>` and fund this address.
GAMES_PAYOUT_ADDRESS=

# ---- UltraGrid (AppChain #1) --------------------------------------------------------------------
# 10 base units = 0.00001 $ULTRA: the phase-1 TEST reward (V2 R4b). Ceiling 1000.
GAMES_GRID_REWARD_UNITS=10
GAMES_GRID_REWARDED_PER_ADDRESS_PER_DAY=3
GAMES_GRID_REWARDED_PER_DAY=2000
GAMES_GRID_PAYS=true
GAMES_GRID_CHAIN_ID=1

# ---- Ultra Chess (AppChain #2, not registered yet) ----------------------------------------------
# Chess does NOT pay unless this line says true. The code's own default is record-only, and a missing
# line here is record-only too, so no configuration accident can start paying for results nobody proved:
# chess results are REPORTED BY THE PHONE and the server cannot verify one of them. Wins are recorded
# and anchored either way, so the chain still gets its data. Before turning it on, read
# GAMES_RULES_AND_PAYOUTS.md §2.2 and §6 (P1): every unit it pays can be collected by a program without
# a human playing. `check-config` prints RECORD ONLY while this is false.
GAMES_CHESS_PAYS=false
GAMES_CHESS_REWARD_UNITS=100
GAMES_CHESS_REWARDED_PER_ADDRESS_PER_DAY=3
# Read only while chess pays: 200 a day = at most 0.02 $ULTRA, kept small enough not to starve Grid's
# share of the one pool (V2's standard is 2000). Raise it only once a server-side opponent exists.
GAMES_CHESS_REWARDED_PER_DAY=200
GAMES_CHESS_CHAIN_ID=2
GAMES_CHESS_MIN_PLIES=10
GAMES_CHESS_MAX_PLIES=600

# ---- Across games --------------------------------------------------------------------------------
GAMES_REWARDED_GLOBAL_PER_DAY=20000
# A flood limit, not an anti-farm rule: mobile carriers put many phones behind one address.
GAMES_REWARDED_PER_CLIENT_PER_DAY=30
# Reward only addresses that exist on the chain (a balance or a transaction). Turning this off lets
# anyone mint addresses to collect rewards: leave it true.
GAMES_REQUIRE_CHAIN_PRESENCE=true

# ---- Payouts -------------------------------------------------------------------------------------
# 100 base units = 0.0001 $ULTRA; the whole balance is paid. The network fee is paid by the payout
# wallet, never by the player.
GAMES_WITHDRAW_MIN_UNITS=100
# The most that can be queued for withdrawal per UTC day, however large the wallet.
GAMES_PAYOUT_DAILY_CAP_UNITS=200000
# A payout is not attempted unless the wallet holds amount + fee + this much.
GAMES_PAYOUT_RESERVE_UNITS=1000
# Seconds from signing before an unconfirmed payout pauses payments for a human. A signed transfer
# older than an hour can never be accepted, so the ceiling is 3000.
GAMES_CONFIRMATION_TIMEOUT_SECONDS=900
GAMES_MAX_SUBMISSION_ATTEMPTS=20

# ---- Daily anchoring through appchain-cli ---------------------------------------------------------
# Leave GAMES_ANCHOR_CLI unset to disable automatic anchoring (days can still be closed by hand with
# `ultranet-games close-day`). Which games are anchored: add `chess` only after its chain is registered.
# GAMES_ANCHOR_CLI=/opt/ultranet-games/appchain-cli
# GAMES_ANCHOR_GAMES=grid
# Anchor yesterday even if nobody won, so a listed chain is "live" (V2 C-2). 0.001 $ULTRA a day.
GAMES_ANCHOR_EMPTY_DAYS=true
GAMES_ANCHOR_RETRY_SECONDS=600
GAMES_ANCHOR_TIMEOUT_SECONDS=60

# ---- Third-party games: the registry ---------------------------------------------------------------
# Games registered with `ultranet-games game-register` record results here. The platform records
# claims and makes them tamper-evident; it never pays for them. Every game's day folds into ONE root,
# anchored once a day on the registry's own AppChain, so a thousand games cost one anchor fee a day.
# Leave GAMES_REGISTRY_CHAIN_ID unset until that AppChain is registered (owner action, 0.01 $ULTRA):
# results are still recorded and each day's root is still fixed, but nothing is anchored.
# It must differ from 0 and from the Grid and Chess chains. Anchoring also needs GAMES_ANCHOR_CLI above.
# GAMES_REGISTRY_CHAIN_ID=3
# Limits per UTC day. Tighten freely; ceilings are 1000000 / 100000 / 10000 and 0 is refused.
GAMES_REGISTRY_RESULTS_PER_GAME_PER_DAY=50000
GAMES_REGISTRY_RESULTS_PER_PLAYER_PER_DAY=1000
# A sandbox game is free, private and never anchored, so its day is small.
GAMES_REGISTRY_SANDBOX_RESULTS_PER_DAY=500
