# UltraNet faucet staging configuration template.
# STAGING ONLY: never copy this file or its values into production.
# This file contains policy and endpoint values only. Never put private keys,
# Turnstile secrets, abuse keys, operator tokens, or ULTRANET_ADMIN_TOKEN here.
# The staging host must run a separate validator, database, signer, and budget.

# The staging listener is loopback-only; publish it through the staging TLS proxy.
FAUCET_BIND=127.0.0.1:8090

# The staging validator API must be local to the staging VPS.
FAUCET_NODE_API_BASE_URL=http://127.0.0.1:8081

# Replace this placeholder with the address printed by the staging-only keygen.
# Never use the production faucet address or a validator/sovereign signer here.
FAUCET_ADDRESS=replace-with-derived-staging-faucet-address

# Keep the production claim amount for contract compatibility, but cap staging
# to three complete source debits (claim plus minimum fee) per day.
FAUCET_CLAIM_AMOUNT_BASE_UNITS=1000000
FAUCET_DAILY_DEBIT_CAP_BASE_UNITS=3030000
FAUCET_MIN_BALANCE_RESERVE_BASE_UNITS=10000000
FAUCET_ADDRESS_COOLDOWN_SECONDS=86400
FAUCET_MAX_QUEUE_LENGTH=10
FAUCET_MAX_SUBMISSION_ATTEMPTS=5
FAUCET_CONFIRMATION_TIMEOUT_SECONDS=900

# Staging is fail-closed until all preflight gates pass.
FAUCET_ENABLED=false
FAUCET_CAPTCHA_PROVIDER=turnstile
# Must match the exact hostname configured in the staging Turnstile widget.
FAUCET_TURNSTILE_HOSTNAME=faucet-staging.ultranetwork.cc
FAUCET_STATE_PATH=/var/lib/ultranet-faucet-staging/faucet.db

# These aliases must match the staging systemd unit's credential mappings.
# The corresponding encrypted .cred files belong only on the staging host.
FAUCET_SIGNER_CREDENTIAL=faucet-staging-signer.json
FAUCET_TURNSTILE_CREDENTIAL=faucet-staging-turnstile.secret
FAUCET_ABUSE_KEY_CREDENTIAL=faucet-staging-abuse.key
FAUCET_OPERATOR_TOKEN_CREDENTIAL=faucet-staging-operator.token
