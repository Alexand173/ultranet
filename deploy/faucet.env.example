# Copy to /etc/ultranet-faucet/faucet.env — the path ultranet-faucet.service reads — and restrict it
# to root:ultranet-faucet (0640).
# This file contains policy and endpoint values only. Never put private keys,
# Turnstile secrets, abuse keys, operator tokens, or ULTRANET_ADMIN_TOKEN here.

# The faucet listener is loopback-only; publish it through the TLS reverse proxy.
FAUCET_BIND=127.0.0.1:8090

# The validator API remains private and loopback-only.
FAUCET_NODE_API_BASE_URL=http://127.0.0.1:8081

# Must match the public key in the dedicated signer credential.
# This is the address the production signer derives on ubuntu-4gb-nbg1-2; a mismatch is refused at start.
FAUCET_ADDRESS=fe0b9a9227ebb2bb40b408c5b10b0155a2591fdf97ce43580a1ab873271af1f8

# Fixed mainnet-beta claim: 0.100000 $ULTRA at six decimals. The promotion is an onboarding
# taste, not a balance: 0.1 funds about ten times as many first-time users as 1.0 and is worth a
# tenth as much to a bot, while still covering a real payment (0.05 costs 0.0005 in fees).
FAUCET_CLAIM_AMOUNT_BASE_UNITS=100000
# 10 $ULTRA a day, about 99 claims at the current claim size.
FAUCET_DAILY_DEBIT_CAP_BASE_UNITS=10000000
FAUCET_MIN_BALANCE_RESERVE_BASE_UNITS=200000000
FAUCET_ADDRESS_COOLDOWN_SECONDS=86400
# Per-source claims in a rolling day. A mobile audience shares carrier CGNAT addresses and an
# office shares one address, so a tight per-IP maximum rejects real first-time claimants. The
# 24-hour destination cooldown already prevents duplicates and the daily debit cap bounds a
# coordinated drain; these limits only blunt casual abuse. 0 removes a limit for that scope.
FAUCET_IP_CLAIMS_PER_DAY=25
FAUCET_SUBNET_CLAIMS_PER_DAY=250
FAUCET_MAX_QUEUE_LENGTH=100
FAUCET_MAX_SUBMISSION_ATTEMPTS=5
FAUCET_CONFIRMATION_TIMEOUT_SECONDS=900
# Promotional cap: intake closes once this many claims have confirmed on chain.
# The 10,000th payout both settles and disables intake, and status then reports
# availability "exhausted" until an operator re-enables it. 0 disables the cap.
# Enforced only by a binary built after 9c6370f; older builds ignore this setting entirely.
FAUCET_MAX_CLAIMS=10000

# Intake is fail-closed until the signer, backup, monitoring, and canary are ready.
# This template ships `false` so a copied file cannot open intake by accident; the
# production host runs `true` and reports availability "available".
FAUCET_ENABLED=false
FAUCET_CAPTCHA_PROVIDER=turnstile
# Must match the exact hostname configured in the production Turnstile widget.
FAUCET_TURNSTILE_HOSTNAME=faucet.ultranetwork.cc
FAUCET_STATE_PATH=/var/lib/ultranet-faucet/faucet.db

# These names resolve inside $CREDENTIALS_DIRECTORY under systemd.
FAUCET_SIGNER_CREDENTIAL=faucet-signer.json
FAUCET_TURNSTILE_CREDENTIAL=faucet-turnstile.secret
FAUCET_ABUSE_KEY_CREDENTIAL=faucet-abuse.key
FAUCET_OPERATOR_TOKEN_CREDENTIAL=faucet-operator.token
