# Original UltraNet reverse-proxy configuration © 2026 Vladan Jotov; ISC License.
# Replace the example hostnames with real DNS names.
# The API process listens on 127.0.0.1:8081 and the Next.js site on 127.0.0.1:3000.
#
# Caddy 2.6.x uses trusted_proxies inside each reverse_proxy handler. Do not
# replace this with the newer global `servers` syntax without revalidation.
# Install the Cloudflare range list only after both public origins are proxied.

(cloudflare-trusted-proxy) {
    trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
}

api.example.com {
    # Both services share this hostname, so the app needs no new DNS name or certificate.
    # Two services answer under this hostname, and the proxy sends each path to the one that owns it:
    #   Records Service (127.0.0.1:8096): third-party games and the generic records API.
    #   Games Reward Service (127.0.0.1:8095): UltraGrid, Ultra Chess, wallets, withdrawals.
    # /internal/* is deliberately not routed at all: it is the Records Service's signed route for the
    # Games service and is reachable only on loopback.
    # `Authorization` is NOT stripped on the Records Service's routes: it carries a game's API key
    # (Bearer) on result submission, and removing it would answer every submission with 401. Bodies there
    # may reach ~15 KB (a signed registration carries a post-quantum public key and signature), so the
    # cap is the service's own 32 KB. The Games Reward Service reads the player session from `X-Wallet-Session`, not Authorization.
    @records path /api/games/g /api/games/g/* /api/games/registry/* /api/records /api/records/* /api/apps /api/apps/*
    handle @records {
        request_body {
            max_size 32KB
        }
        reverse_proxy 127.0.0.1:8096 {
            import cloudflare-trusted-proxy
            header_up -Cookie
            header_up -CF-Connecting-IP
            header_up -Forwarded
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Proto
            header_up -X-Real-IP
            transport http {
                dial_timeout 2s
                response_header_timeout 20s
            }
        }
    }

    # The games service (UltraGrid, Ultra Chess) answers everything else under /api/games. Enable only
    # after it has been installed from deploy/ultranet-games.service and docs/runbooks/games-service.md.
    # Add the Cloudflare rate limits from that runbook before opening it: the service has caps, not a login.
    handle /api/games/* {
        request_body {
            max_size 16KB
        }
        reverse_proxy 127.0.0.1:8095 {
            import cloudflare-trusted-proxy
            header_up -Authorization
            header_up -Cookie
            header_up -CF-Connecting-IP
            header_up -Forwarded
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Proto
            header_up -X-Real-IP
            transport http {
                dial_timeout 2s
                response_header_timeout 20s
            }
        }
    }

    handle {
        reverse_proxy 127.0.0.1:8081 {
            import cloudflare-trusted-proxy
            # Caddy rebuilds X-Forwarded-For from trusted proxy ranges;
            # direct-origin requests cannot choose the client identity.
            header_up -Forwarded
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Proto
            header_up -X-Real-IP
            header_up -CF-Connecting-IP
        }
    }
}

dashboard.example.com {
    reverse_proxy 127.0.0.1:3000
}

# Enable only after local integration, signer/address, backup/restore,
# Cloudflare WAF, origin-lockdown, and canary gates are complete.
# The UI/API origin is this same hostname. `deploy/faucet-site/` is the claim page; install it
# at /var/www/faucet (see the handle below). Keep every other path on the 404.
faucet.example.com {
    request_body {
        max_size 16KB
    }

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Cross-Origin-Resource-Policy "same-origin"
        Cache-Control "no-store"
        -Server
    }

    @faucet_create {
        method POST
        path /api/faucet/claims
    }

    @faucet_read {
        method GET
        path /api/faucet/status /api/faucet/claims/*
    }

    handle @faucet_create {
        reverse_proxy 127.0.0.1:8090 {
            import cloudflare-trusted-proxy
            header_up -Authorization
            header_up -Cookie
            header_up -X-UltraNet-CSRF
            header_up -CF-Connecting-IP
            header_up -Forwarded
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Proto
            header_up -X-Real-IP
            transport http {
                dial_timeout 2s
                response_header_timeout 20s
            }
        }
    }

    handle @faucet_read {
        reverse_proxy 127.0.0.1:8090 {
            import cloudflare-trusted-proxy
            header_up -Authorization
            header_up -Cookie
            header_up -X-UltraNet-CSRF
            header_up -CF-Connecting-IP
            header_up -Forwarded
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Proto
            header_up -X-Real-IP
            transport http {
                dial_timeout 2s
                response_header_timeout 20s
            }
        }
    }

    # The claim page: the form, its stylesheet and its script. Nothing else is served from disk,
    # and /internal/* stays unreachable because it matches none of these paths.
    @faucet_page {
        method GET HEAD
        path / /styles.css /app.js
    }

    handle @faucet_page {
        root * /var/www/faucet
        file_server
    }

    # Never proxy /internal/*, unsupported methods, or unknown paths.
    handle {
        respond "Not found" 404
    }
}
