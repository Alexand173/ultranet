# Original UltraNet reverse-proxy configuration © 2026 Vladan Jotov; ISC License.
# Replace the example hostnames with real DNS names.
# The API process listens on 127.0.0.1:8081 and the Next.js site on 127.0.0.1:3000.
#
# Caddy 2.6.x uses trusted_proxies inside each reverse_proxy handler. Do not
# replace this with the newer global `servers` syntax without revalidation.
# Install the Cloudflare range list only after both public origins are proxied.

(cloudflare-trusted-proxy) {
    trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
}

api.example.com {
    reverse_proxy 127.0.0.1:8081 {
        import cloudflare-trusted-proxy
        # Caddy rebuilds X-Forwarded-For from trusted proxy ranges;
        # direct-origin requests cannot choose the client identity.
        header_up -Forwarded
        header_up -X-Forwarded-Host
        header_up -X-Forwarded-Proto
        header_up -X-Real-IP
        header_up -CF-Connecting-IP
    }
}

dashboard.example.com {
    reverse_proxy 127.0.0.1:3000
}

# Enable only after local integration, signer/address, backup/restore,
# Cloudflare WAF, origin-lockdown, and canary gates are complete.
# The preferred future UI/API origin is this same hostname. The repository
# currently has no faucet UI, so this block is API-only until one is deployed.
faucet.example.com {
    request_body {
        max_size 16KB
    }

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Cross-Origin-Resource-Policy "same-origin"
        Cache-Control "no-store"
        -Server
    }

    @faucet_create {
        method POST
        path /api/faucet/claims
    }

    @faucet_read {
        method GET
        path /api/faucet/status /api/faucet/claims/*
    }

    handle @faucet_create {
        reverse_proxy 127.0.0.1:8090 {
            import cloudflare-trusted-proxy
            header_up -Authorization
            header_up -Cookie
            header_up -X-UltraNet-CSRF
            header_up -CF-Connecting-IP
            header_up -Forwarded
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Proto
            header_up -X-Real-IP
            transport http {
                dial_timeout 2s
                response_header_timeout 20s
            }
        }
    }

    handle @faucet_read {
        reverse_proxy 127.0.0.1:8090 {
            import cloudflare-trusted-proxy
            header_up -Authorization
            header_up -Cookie
            header_up -X-UltraNet-CSRF
            header_up -CF-Connecting-IP
            header_up -Forwarded
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Proto
            header_up -X-Real-IP
            transport http {
                dial_timeout 2s
                response_header_timeout 20s
            }
        }
    }

    # Never proxy /internal/*, unsupported methods, or unknown paths.
    handle {
        respond "Not found" 404
    }
}
