# Copy to /etc/ultranet/ultranet.env and restrict it to root/ultranet (0640).
# Do not place private sovereign keys in this file.

# The systemd service binds locally; expose it through a TLS reverse proxy.
ULTRANET_API_BIND=127.0.0.1:8081

# Comma-separated explicit browser origins. Wildcards are rejected.
ULTRANET_CORS_ORIGINS=https://dashboard.example.com

# Durable Sled state. Keep this directory on persistent NVMe storage.
ULTRANET_DB_PATH=/var/lib/ultranet

# Required for administrative/state-changing API routes used by automation.
# Generate with: openssl rand -hex 32
ULTRANET_ADMIN_TOKEN=replace-with-output-of-openssl-rand-hex-32

# Optional browser wallet authentication allowlist. Use exact 64-character
# node identifiers derived from approved Dilithium public keys.
ULTRANET_AUTHORIZED_NODE_IDENTIFIERS=f86ca985b1c25a8f00b8ff904ec956d1b2ffa323efd69965a0b41a3e0d5b628a,e6766eab2df27d29a224fe8554b0ca22ce100323993e3554ec7eeb9d590fa37b,cc30a94cf2d372537a10976232cbf2fcb68869a7f01037b3913e3fdfabafedba
ULTRANET_AUTH_CHALLENGE_TTL_SECONDS=300
ULTRANET_AUTH_SESSION_TTL_SECONDS=28800
# Keep true in production HTTPS deployments. Set false only for local HTTP development.
ULTRANET_SESSION_COOKIE_SECURE=true
# Share auth cookies across dashboard.ultranetwork.cc and api.ultranetwork.cc.
# Leave unset for single-origin/local deployments.
ULTRANET_AUTH_COOKIE_DOMAIN=ultranetwork.cc
