# Copy this file to UltraNetNode.env before starting the Windows node.
# Keep UltraNetNode.env private. Never commit or share the admin token.

# Strong private administrator bearer token for state-changing operations.
# Recommended format: 32 random bytes / 64 lowercase hexadecimal characters.
# Current validation requires at least 32 non-whitespace bytes, but does not yet
# enforce hexadecimal characters or exactly 64 characters.
# Never use a short password, reused token, wallet key, public node identifier,
# or DILITHIUM_PUB_KEY.
# OpenSSL: openssl rand -hex 32
# PowerShell:
# $bytes = New-Object byte[] 32
# $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $rng.GetBytes($bytes)
# [BitConverter]::ToString($bytes).Replace('-', '').ToLowerInvariant()
# $rng.Dispose()
ULTRANET_ADMIN_TOKEN=replace-with-a-new-64-hex-character-token

# Local API listener. Keep the API private unless you understand the proxy setup.
ULTRANET_API_BIND=127.0.0.1:8081
ULTRANET_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The default is %LOCALAPPDATA%\UltraNet\data, a writable per-user directory.
# Set this only when you need a specific location. Use a real Windows path;
# the strict env-file parser does not expand %VARIABLE% placeholders.
# ULTRANET_DB_PATH=C:\Users\YourName\AppData\Local\UltraNet\data

# Set to true when launching directly from a terminal and you do not want a pause.
# The supplied desktop launcher sets this automatically on startup failures.
# ULTRANET_PAUSE_ON_ERROR=false
